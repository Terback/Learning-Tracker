# Prisma datasource configuration for Supabase PostgreSQL.
#
# Get both values from: Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Never commit the real .env file (it is already gitignored).

# DATABASE_URL: pooled connection used by the app at runtime (Supavisor, "Transaction" mode, port 6543).
# Required for serverless/Vercel because each function invocation opens its own connection, and the
# pooler prevents exhausting Postgres' direct connection limit. `pgbouncer=true` tells Prisma to skip
# features (like prepared statement caching) that transaction-mode pooling doesn't support.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: direct, non-pooled connection (port 5432) used only by Prisma Migrate / `db push`.
# Schema migrations need a direct connection because transaction-mode pooling does not support the
# session-level operations Prisma's migration engine relies on.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Auth configuration for the browser + server clients.
# Get both from: Supabase Dashboard -> Project Settings -> API.
# NEXT_PUBLIC_* values are exposed to the browser by Next.js at build time - only put publishable
# values here, never a service_role/secret key.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

# ALLOWED_SIGNUP_EMAILS: comma-separated list of emails allowed to self-register via /signup.
# Server-side only (no NEXT_PUBLIC_ prefix) so the list is never sent to the browser. Signup
# requests for any other email are rejected before Supabase Auth is ever called.
ALLOWED_SIGNUP_EMAILS="person1@example.com,person2@example.com"

# --- Local SQLite prototype (previous v0.1 datasource) ---
# Kept here for reference only. Do not use alongside the postgresql provider above without also
# reverting prisma/schema.prisma's datasource block back to "sqlite".
# DATABASE_URL="file:./dev.db"
